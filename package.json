{
  "name": "meritdesk-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:connector-discovery": "node --conditions=react-server --import tsx --test tests/connector-discovery.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-skills": "tsx src/db/seed-skills.ts",
    "release": "npm run db:migrate && npm run db:seed-skills",
    "worker": "tsx watch --conditions=react-server src/worker.ts",
    "worker:start": "node --conditions=react-server --import tsx src/worker.ts",
    "library:probe": "tsx --conditions=react-server src/services/library/cli/probe.ts",
    "library:db-check": "tsx --conditions=react-server src/services/library/cli/db-check.ts",
    "library:smoke": "tsx --conditions=react-server src/services/library/cli/smoke.ts",
    "eoir-stats:load": "tsx --conditions=react-server src/services/library/adapters/eoir-statistics/cli.ts",
    "eoir-stats:check": "tsx --conditions=react-server src/services/library/adapters/eoir-statistics/check.ts",
    "stripe:setup": "tsx src/lib/billing/cli/stripe-setup.ts",
    "billing:comp": "tsx --conditions=react-server src/lib/billing/cli/complimentary.ts",
    "env:check": "node scripts/check-env-example.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sesv2": "3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@clerk/backend": "^3.16.6",
    "@clerk/nextjs": "^7.7.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "pdfjs-dist": "6.3.289",
    "pg-boss": "^12.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "23.1.0",
    "svix": "^1.99.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
